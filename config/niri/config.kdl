// =============================================================================
// NIRI CONFIGURATION - ESTÉTICA Y PRODUCTIVIDAD MAXIMIZADA
// =============================================================================

// Solicita a las aplicaciones que omitan sus barras de título de cliente (CSD).
// Esto garantiza esquinas redondeadas y bordes limpios dibujados por Niri.
prefer-no-csd

// Configuración de entrada
input {
    keyboard {
        xkb {
            // Puedes cambiar la distribución de teclado (ej: "es", "latam", "us")
            layout "es,us"
            options "grp:win_space_toggle"
        }
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        dwt // Deshabilitar mientras se escribe
    }

    mouse {
        accel-speed 0.0
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

// -----------------------------------------------------------------------------
// LAYOUT: DIMENSIONES, BORDES, SOMBRAS Y ESPACIADOS
// -----------------------------------------------------------------------------
layout {
    // Espacio entre ventanas y márgenes en píxeles lógicos
    gaps 16

    // Comportamiento de centrado:
    // "on-overflow" centra la ventana sólo si no cabe junto a la anterior
    center-focused-column "on-overflow"

    // Ancho predeterminado al abrir una ventana (50% de la pantalla)
    default-column-width { proportion 0.5; }

    // Tamaños alternables con Mod+R (1/3, 1/2, 2/3 y pantalla completa)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Bordes de ventanas con degradado dinámico (colores cian y esmeralda)
    border {
        width 2
        active-gradient from="#33ccff" to="#00ff99" angle=45 in="oklch longer hue"
        inactive-color "#2a2d37"
        urgent-color "#ff5555"
    }

    // El focus-ring se deshabilita para priorizar el borde integrado
    focus-ring {
        off
    }

    // Sombras gaussianas modernas
    shadow {
        on
        softness 32
        spread 4
        offset x=0 y=6
        draw-behind-window true
        color "#00000075"
        inactive-color "#00000040"
    }

    // Pestañas verticales para ventanas agrupadas en la misma columna
    tab-indicator {
        width 4
        gap 4
        position "left"
        active-gradient from="#33ccff" to="#00ff99" angle=90
        inactive-color "#3b4252"
    }
}

// -----------------------------------------------------------------------------
// EFECTOS VISUALES: DESENFOQUE (BLUR GPU)
// -----------------------------------------------------------------------------
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.4
}

// -----------------------------------------------------------------------------
// REGLAS GLOBALES Y POR APLICACIÓN (WINDOW RULES)
// -----------------------------------------------------------------------------

// 1. Esquinas redondeadas y recorte geométrico universal
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// 2. Atenuación estética para ventanas inactivas
window-rule {
    match is-active=false
    opacity 0.88
}

// 3. Desenfoque de fondo nativo para terminales y lanzadores translúcidos
window-rule {
    match app-id="kitty"
    match app-id="Alacritty"
    match app-id="foot"

    background-effect {
        blur true
        xray true
    }
}

// 4. Ventanas flotantes por defecto (diálogos, utilidades, popups)
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="pavucontrol"
    match app-id="blueman-manager"
    match app-id="nm-connection-editor"
    match app-id="thunar" title="^Progreso de las operaciones de archivo.*"
    match is-floating=true

    open-floating true
    default-column-width {}
}

// -----------------------------------------------------------------------------
// ANIMACIONES DINÁMICAS (FÍSICAS DE RESORTE / SPRINGS)
// -----------------------------------------------------------------------------
animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// -----------------------------------------------------------------------------
// PROGRAMAS AL INICIAR LA SESIÓN (AUTOSTART)
// -----------------------------------------------------------------------------
spawn-at-startup "fusuma"
spawn-at-startup "bash" "-c" "killall -q xdg-desktop-portal-gnome xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal; /usr/lib/xdg-desktop-portal &"


// Ruta para capturas de pantalla
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H-%M-%S.png"

// -----------------------------------------------------------------------------
// ATAJOS DE TECLADO (BINDS)
// -----------------------------------------------------------------------------
binds {
    // Ayuda visual de atajos
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Aplicaciones principales
    Mod+Return { spawn "kitty"; }
    Mod+T      { spawn "kitty"; }
    Mod+Space  { spawn "serpantinum-launcher"; }
    Mod+D      { spawn "serpantinum-launcher"; }
    Mod+E      { spawn "thunar"; }
    Mod+B      { spawn "firefox"; }

    // Gestión de ventanas
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Alternar flotante / tiling
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Modo pestaña en columna
    Mod+W { toggle-column-tabbed-display; }

    // Navegación de foco (Flechas o HJKL)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Mover columnas / ventanas (Ctrl + Flechas o Ctrl + HJKL)
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // Primera y última columna
    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Agrupar (consumir) o expulsar ventanas de una columna
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Control de tamaño de ventanas
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }

    // Ajustes finos de ancho (-10% / +10%)
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Espacios de trabajo (Workspaces)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Scroll con rueda de ratón para desplazarse lateralmente
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Desplazarse por espacios de trabajo
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Control de volumen (PipeWire / WirePlumber)
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Control de reproducción multimedia
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // Control de brillo de pantalla
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Capturas de pantalla
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Salir de Niri
    Mod+Shift+E { quit; }
}
